          </datasource-dependencies>
          <datasource-dependencies datasource='federated.025viyv0fb3uas199qejh18aawfj'>
            <column caption='Title Matches Search' datatype='boolean' name='[Calculation_2033445643984203787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEN(TRIM([Parameters].[Parameter 1])) = 0&#10;OR CONTAINS( LOWER([title]), LOWER([Parameters].[Parameter 1]) )' />
