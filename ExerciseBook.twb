      </column>
      <column caption='Genre Rank' datatype='integer' name='[Calculation_2033445644107575329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_2033445644107477024], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Genre %' datatype='real' name='[Calculation_2033445644108070946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2033445644107477024] / TOTAL([Calculation_2033445644107477024]) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rating Intensity' datatype='real' name='[Calculation_2033445644135677987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[rating_count] / (YEAR(TODAY()) - [release_year] + 1)' />
      </column>
      <column caption='Rank per Genre' datatype='integer' name='[Calculation_2033445644157141034]' role='measure' type='quantitative'>
