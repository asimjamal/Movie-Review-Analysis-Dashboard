        </calculation>
      </column>
      <column caption='Total Movies' datatype='integer' name='[Calculation_2033445644106178589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(COUNTD([title]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Movie Per Genre' datatype='integer' name='[Calculation_2033445644107477024]' role='measure' type='quantitative'>
